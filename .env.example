# Neon writes the real values into .env.local. Never commit that file.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DRAWINGS_BUCKET=drawings
# Local development stays on localhost. In Vercel Production set https://sketchlet.app.
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=5173

# Optional public account sign-in. Use matching Clerk development keys locally.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY / VITE_CLERK_PUBLISHABLE_KEY are accepted aliases.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional administrator sign-in. All values are required to enable it.
# Use separate GitHub OAuth apps and credentials for local and production.
# In Vercel Production set ADMIN_ORIGIN=https://sketchlet.app.
ADMIN_ORIGIN=http://localhost:5173
ADMIN_GITHUB_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
