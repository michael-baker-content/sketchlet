{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": { "maxDuration": 30 },
    "api/pages.js": { "maxDuration": 30, "includeFiles": "{index.html,gallery.html}" }
  },
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/gallery.html", "destination": "/gallery", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__sketchlet_path=:path*" },
    { "source": "/", "destination": "/api/pages?__page=/" },
    { "source": "/gallery", "destination": "/api/pages?__page=/gallery" },
    { "source": "/gallery/", "destination": "/api/pages?__page=/gallery" },
    { "source": "/d/:id", "destination": "/api/pages?__page=/d/:id" },
    { "source": "/social/:path*", "destination": "/api/pages?__page=/social/:path*" },
    { "source": "/robots.txt", "destination": "/api/pages?__page=/robots.txt" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store" }]
    },
    {
      "source": "/src/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
